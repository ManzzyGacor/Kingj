import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

async function menu(sock, sender) {

const name = sender.split("@")[0];

// Uptime
const uptime = process.uptime();
const jam = Math.floor(uptime / 3600);
const menit = Math.floor((uptime % 3600) / 60);
const detik = Math.floor(uptime % 60);

// Total grup
const groups = await sock.groupFetchAllParticipating();
const totalGroup = Object.keys(groups).length;

// Auto detect plugin
const files = fs.readdirSync(__dirname)
  .filter(file => file.endsWith(".js") && file !== "menu.js")
  .map(file => file.replace(".js", ""))
  .sort();

const commandList = files.map(cmd => `• .${cmd}`).join("\n");

const teks = `
╭━━━〔 👑 KING JPM 👑 〕━━━╮
┃   KING JPM Broadcast System
╰━━━━━━━━━━━━━━━━━━━━━━╯

*👤 User*     : ${name}
*👥 Total Grup* : ${totalGroup}
*⏳ Runtime*   : ${jam}j ${menit}m ${detik}d
*👨‍💻 Developer* : ManzzyID
╭━━━━━━━━━━━━━━━━━━━━━━╮
${commandList}
╰━━━━━━━━━━━━━━━━━━━━━━╯

🖥 © KING JPM - By ManzzyID
`;

await sock.sendMessage(sender, {
  text: teks,
  contextInfo: {
    externalAdReply: {
      title: "KING JPM System",
      body: "KING JPM Server Panel",
      thumbnailUrl: "https://litter.catbox.moe/d9s1j3.jpg",
      sourceUrl: "https://whatsapp.com/channel/0029Vb80712Jf05eHpEJJH1v",
      mediaType: 1,
      renderLargerThumbnail: true,
      showAdAttribution: false
    }
  }
});

}

export default menu;